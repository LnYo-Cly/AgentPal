{
  "expo": {
    "name": "AgentPal",
    "slug": "agentpal",
    "scheme": "agentpal",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.agentpal.mobile"
    },
    "android": {
      "package": "dev.agentpal.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E8"
      }
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AgentPal to scan the desktop Host pairing QR code.",
          "microphonePermission": "Allow AgentPal to record voice instructions for agent sessions."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#247C6D"
        }
      ]
    ]
  }
}
