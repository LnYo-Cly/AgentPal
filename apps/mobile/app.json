{
  "expo": {
    "name": "AgentPal",
    "slug": "agentpal",
    "scheme": "agentpal",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.agentpal.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "AgentPal uses the camera to scan desktop Host pairing QR codes."
      }
    },
    "android": {
      "package": "dev.agentpal.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E8"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "AgentPal uses the camera to scan desktop Host pairing QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store"
    ]
  }
}
